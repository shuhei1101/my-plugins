{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "_description": "masterマージ前にプラグインバージョン更新漏れを検知してブロックする",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-merge-version-check.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "_description": "masterマージ後にpush + marketplace upgrade + reload-pluginsを実行する",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-merge-upgrade.py"
            ]
          }
        ]
      }
    ]
  }
}
