{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",

        "hooks": [
          {
            "type": "command",
            "_description": "編集対象ファイルにマッチする research-kit のルールを注入",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/inject_rules/injector.py"
            ]
          }
        ]
      }
    ]
  }
}
