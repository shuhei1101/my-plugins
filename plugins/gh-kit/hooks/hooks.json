{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "_description": "gh-kit 定数（ラベル名・カラー等）を環境変数としてセッション内に展開する",
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/constants.sh"
            ]
          },
          {
            "_description": "GH_KIT_REPO_PATH / GH_KIT_WIKI_PATH が設定されていればリポジトリを pull して最新化する",
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-start-pull.sh"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_description": "マージ前に master 取り込み確認＋dry-run コンフリクトチェック（AI 自動マージの安全網）",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/pre-merge-check.py"
            ]
          }
        ]
      }
    ]
  }
}
