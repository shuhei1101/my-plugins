{
  "description": "AITuber notify plugin - POSTs session completion to AITuber on Stop",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1\""
          }
        ]
      }
    ]
  }
}
