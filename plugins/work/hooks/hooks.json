{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "_description": "ルールを注入",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/rules/inject_rules.py"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "_description": "保護ブランチ（main/master/develop）への直接編集をブロックし /work:start の使用を促す",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/protected-branch-guard.py"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_description": "マスターコミットガード",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/master-commit-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/master-commit-guard.md"
            ]
          },
          {
            "_description": "push / merge を検出して確認を挟む",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.md"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "_description": "セッション開始時に work プラグイン概要を注入",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.md"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "_description": "workスキル実行指示",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/work_start_reminder.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/work_start_reminder.md"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "_description": "レスポンス終了時に QA・マージ提案リマインダーを出力",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/work_complete_check.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/work_complete_check.md"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "_description": "圧縮前にセッション知識をアーティファクト化するスキルを実行",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.md"
            ]
          },
          {
            "_description": "圧縮前にセッショントークンを削除",
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/rules/clear_session_token.py"]
          }
        ]
      }
    ]
  }
}
