{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "_description": "ルールを注入",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/rules/inject_rules.py"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_description": "マスターコミットガード",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/master-commit-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/master-commit-guard.md"
            ]
          },
          {
            "_description": "push / merge を検出して確認を挟む",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.md"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "_description": "workスキル実行指示",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.md"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "_description": "レスポンス終了時に TODO / QA リマインダーを出力",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop.md"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "_description": "圧縮前にセッション知識をアーティファクト化するスキルを実行",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.md"
            ]
          },
          {
            "_description": "圧縮前にセッショントークンを削除",
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/rules/clear_session_token.py"]
          }
        ]
      }
    ]
  }
}
