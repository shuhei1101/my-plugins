{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_description": "マージ前に master 取り込み確認＋dry-run コンフリクトチェック",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/pre-merge-check.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "_description": "ユーザープロンプト送信時に /work:start スキル実行指示を出す",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit/start_reminder.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit/start_reminder.md"
            ]
          },
          {
            "_description": "Claude Code タスク（TaskCreate/TaskList/TaskUpdate）の登録を促す",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit/task_reminder.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit/task_reminder.md"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "_description": "セッション開始時に work プラグインの作業フロー + タスクツール使い方を注入",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start/session_start.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start/session_start.md"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "_description": "レスポンス終了時に /work:merge 提案リマインダーを出力",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop/merge_reminder.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop/merge_reminder.md"
            ]
          }
        ]
      }
    ]
  }
}
