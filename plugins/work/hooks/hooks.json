{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          {
            "_description": "ルールを注入",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/inject_rules.py"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "_description": "保護ブランチ（main/master/develop）への直接編集をブロックし /work:start の使用を促す",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/protected-branch-guard.py"
            ]
          },

          {
            "_description": ".git/** および主要パッケージマネージャの lock ファイルへの Edit/Write を永久ブロック",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/dotgit-lockfile-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/dotgit-lockfile-guard.md"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_description": ".git / .claude / .gitignore / .gitattributes への削除操作を永久ブロック",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/delete-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/delete-guard.md"
            ]
          },

          {
            "_description": "危険な git コマンド（worktree remove --force / git rm 重要ファイル / -X ours/theirs 等）を永久ブロック",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/dangerous-git-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/dangerous-git-guard.md"
            ]
          },
          {
            "_description": "マスターコミットガード",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/master-commit-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/master-commit-guard.md"
            ]
          },
          {
            "_description": "マージ前にmaster取り込み確認＋dry-runコンフリクトチェック",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/pre-merge-check.py"
            ]
          },
          {
            "_description": "push / merge を検出して確認を挟む",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/git-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use/git-guard.md"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "_description": "セッション開始時に work プラグイン概要を注入",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start/session_start.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start/session_start.j2"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "_description": "workスキル実行指示",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit/work_start_reminder.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit/work_start_reminder.md"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "_description": "レスポンス終了時に QA・マージ提案リマインダーを出力",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop/work_complete_check.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop/work_complete_check.md"
            ]
          },

          {
            "_description": "直近コミットでN件超のファイル削除があれば警告コンテキストを注入",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop/post-commit-deletion-check.py"
            ]
          },
          {
            "_description": "保留中の /reload-plugins を自セッションへ遅延送信",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop/reload_deferred.py"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "_description": "圧縮前にセッション知識をアーティファクト化するスキルを実行",
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact/pre-compact.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact/pre-compact.md"
            ]
          },
          {
            "_description": "圧縮前にセッショントークンを削除",
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact/clear_session_token.py"]
          }
        ]
      }
    ]
  }
}
