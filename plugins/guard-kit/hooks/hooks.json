{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/prompts/git-guard.md"
            ]
          }
        ]
      }
    ]
  }
}
